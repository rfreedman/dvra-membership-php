{
    "name": "dvra/membership-manager-php",
    "description": "PHP port of DVRA Membership Manager (shared-hosting friendly, work in progress)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "phpoffice/phpspreadsheet": "^2.0",
        "setasign/fpdf": "^1.8",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.13"
    },
    "autoload": {
        "psr-4": {
            "DvraMembership\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DvraMembership\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    }
}
